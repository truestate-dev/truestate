# Copy to .env and adjust for local dev.
# These same variable names are used in k8s Secrets/ConfigMaps.

# PostgreSQL — local dev default matches docker-compose.yml
DATABASE_URL=postgres://truestate:truestate@localhost:5432/truestate?sslmode=disable

# API server
LISTEN_ADDR=:8080
LOG_LEVEL=info

# Path to SQL migrations dir (relative to working directory or absolute)
MIGRATIONS_PATH=migrations
